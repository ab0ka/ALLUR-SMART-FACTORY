{
  "name": "allur-smart-factory-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local synthetic manufacturing simulation, no real Allur data",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "start:openai": "powershell.exe -NoProfile -File scripts/start-openai.ps1",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "e2e": "node scripts/e2e-ui.mjs",
    "train": "node scripts/train-lift-risk.mjs",
    "policies": "node scripts/compare-policies.mjs",
    "sprites": "node scripts/render-car-sprites.mjs"
  }
}
